# Copy to .env and fill in the keys for the providers you enable in config.yaml.
# Only the providers you enable need a key. Leave the rest blank.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
MISTRAL_API_KEY=

# Any OpenAI-compatible endpoint (xAI Grok, DeepSeek, OpenRouter, Groq, Ollama...).
# Reference these names from config.yaml via `api_key_env`.
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
